<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Deblestia</vendor>
  <vendor_url>https://github.com/kolemm14/Debian-Hyprland-Custom</vendor_url>
  <action id="org.deblestia.installer.manage">
    <description>Install or manage Deblestia desktop components</description>
    <description xml:lang="fr">Installer ou gérer les composants du bureau Deblestia</description>
    <message>Authentication is required to install Deblestia components</message>
    <message xml:lang="fr">L'authentification est requise pour installer les composants Deblestia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/deblestia/deblestia-installer-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
